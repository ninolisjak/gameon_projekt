rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users - profil (ime, ELO, pozicija, reputacija) je viden vsem prijavljenim,
    // ker aplikacija prikazuje soigralce, izravnava ekipe in isce igralce za povabila.
    // Pisanje samo lastnik. Podkolekcije (reputationLog, matchHistory) ostanejo zasebne.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      match /{sub}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Matches - vsi prijavljeni berejo, kdorkoli ustvari.
    // Rezultat, kapetana in zaključek tekme piše samo Cloud Function (admin SDK
    // obide pravila) - odjemalec teh polj ne sme spreminjati, sicer bi lahko
    // obšel soglasje kapetanov in si sam razdelil ELO.
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['scoreA', 'scoreB', 'finalized', 'result',
                      'captainA', 'captainB',
                      'scoreSubmissions', 'scorePhase', 'scoreDisputed']);
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // Klepet tekme. Pravila se ne dedujejo na podkolekcije, zato mora biti
      // zapisano posebej. Berejo in pisejo samo prijavljeni igralci tekme,
      // posiljatelj pa ne more lagati o svoji identiteti.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.players;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.players
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Venues - javno branje, pisanje samo lastnik
    match /venues/{venueId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Schedule slots - javno branje, pisanje samo lastnik igrišča
      match /schedule/{slotId} {
        allow read: if true;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId == request.auth.uid;
      }
    }

    // Reservations - mobilna aplikacija ustvarja, lastnik igrišča in booker bereta
    match /reservations/{resId} {
      allow read: if request.auth != null
        && (resource.data.bookedBy == request.auth.uid
            || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.bookedBy == request.auth.uid
            || resource.data.ownerId == request.auth.uid);
    }
  }
}
