rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && (!('elo' in request.resource.data) || request.resource.data.elo == 700)
        && (!('reputation' in request.resource.data) || request.resource.data.reputation <= 50)
        && !request.resource.data.keys().hasAny(
             ['wins', 'losses', 'draws', 'matchesPlayed', 'goals']
           );

      allow update: if isSelf(uid)
        && !changed().hasAny([
             'uid', 'elo', 'wins', 'losses', 'draws', 'matchesPlayed', 'goals',
             'unlockedBadges'
           ])
        && (
             !changed().hasAny(['reputation'])
             || request.resource.data.reputation <= resource.data.reputation
           );

      allow delete: if false;

      match /reputationLog/{entryId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid);
        allow update, delete: if false;
      }

      match /matchHistory/{entryId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    match /matches/{matchId} {
      function isHost() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      function isPlayer() {
        return signedIn() && request.auth.uid in resource.data.players;
      }

      function attendedOk() {
        return !changed().hasAny(['attended'])
          || (
               'attended' in resource.data
               && request.auth.uid in resource.data.players
               && resource.data.get('matchStarted', false) == true
               && resource.data.get('finalized', false) == false
               && request.resource.data.attended.toSet()
                    .difference(resource.data.attended.toSet())
                    .hasOnly([request.auth.uid])
               && resource.data.attended.toSet()
                    .difference(request.resource.data.attended.toSet())
                    .size() == 0
             );
      }

      function startTimeOk() {
        return !changed().hasAny(['matchStarted', 'startRequested'])
          || !('datetime' in resource.data)
          || request.time >= resource.data.datetime;
      }

      function capacityOk() {
        return !changed().hasAny(['players', 'filledSpots', 'status'])
          || (
               request.resource.data.filledSpots == request.resource.data.players.size()
               && request.resource.data.players.size() <= resource.data.totalSpots
               && (
                    (
                      request.resource.data.status == 'closed'
                      && !changed().hasAny(['players', 'filledSpots'])
                    )
                    || request.resource.data.status == (
                         request.resource.data.players.size() >= resource.data.totalSpots
                           ? 'full' : 'open'
                       )
                  )
             );
      }

      function playersOk() {
        return !changed().hasAny(['players'])
          || (
               request.resource.data.players.toSet()
                 .difference(resource.data.players.toSet())
                 .hasOnly([request.auth.uid])
               && resource.data.players.toSet()
                 .difference(request.resource.data.players.toSet())
                 .hasOnly([request.auth.uid])
             );
      }

      function waitlistOk() {
        return !changed().hasAny(['waitlist'])
          || (
               request.resource.data.waitlist.toSet()
                 .difference(resource.data.waitlist.toSet())
                 .hasOnly([request.auth.uid])
               && resource.data.waitlist.toSet()
                 .difference(request.resource.data.waitlist.toSet())
                 .hasOnly([request.auth.uid])
             );
      }

      function consentOk() {
        return !changed().hasAny(['startConsent'])
          || (
               request.auth.uid in resource.data.players
               && request.resource.data.startConsent.diff(
                    resource.data.get('startConsent', {})
                  ).affectedKeys().hasOnly([request.auth.uid])
             );
      }

      function costSplitOk() {
        return !changed().hasAny(['costSplit'])
          || (
               request.auth.uid in resource.data.players
               && request.resource.data.costSplit.diff(
                    resource.data.get('costSplit', {})
                  ).affectedKeys().hasOnly([request.auth.uid])
             );
      }

      function invitesOk() {
        return !changed().hasAny(['pendingInvites'])
          || request.resource.data.pendingInvites.diff(
               resource.data.get('pendingInvites', {})
             ).affectedKeys().hasOnly([request.auth.uid]);
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.totalSpots is int
        && request.resource.data.totalSpots >= 2
        && request.resource.data.totalSpots <= 30
        && request.resource.data.players.size() <= request.resource.data.totalSpots
        && request.resource.data.filledSpots == request.resource.data.players.size()
        && request.resource.data.datetime is timestamp
        && request.resource.data.datetime > request.time
        && (
             !('finalized' in request.resource.data)
             || request.resource.data.finalized == false
           )
        && (
             !('matchStarted' in request.resource.data)
             || request.resource.data.matchStarted == false
           );

      allow delete: if isHost();

      allow update: if signedIn()
        && !changed().hasAny([
             'scoreA', 'scoreB', 'finalized', 'result',
             'captainA', 'captainB',
             'scoreSubmissions', 'scorePhase', 'scoreDisputed'
           ])
        && !changed().hasAny([
             'createdBy', 'createdAt', 'totalSpots', 'datetime',
             'isPremium', 'isPrivate', 'inviteCode'
           ])
        && resource.data.get('finalized', false) == false
        && startTimeOk()
        && capacityOk()
        && (
             isHost()
             || (
                  changed().hasOnly([
                    'players', 'waitlist', 'filledSpots', 'status',
                    'attended', 'startConsent', 'costSplit',
                    'pendingInvites', 'teamA', 'teamB',
                    'teamsBalanced', 'balanceScore', 'balanceMeta',
                    'startRequested', 'matchStarted', 'matchStartedAt', 'cancelReason'
                  ])
                  && attendedOk()
                  && playersOk()
                  && waitlistOk()
                  && consentOk()
                  && costSplitOk()
                  && invitesOk()
                  && (!changed().hasAny(['cancelReason']) || isPlayer())
                )
           );

      match /messages/{messageId} {
        function players() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data.players;
        }

        allow read: if signedIn() && request.auth.uid in players();

        allow create: if signedIn()
          && request.auth.uid in players()
          && request.resource.data.senderId == request.auth.uid
          && (
               !('text' in request.resource.data)
               || request.resource.data.text.size() <= 2000
             );

        allow update, delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn()
        && !changed().hasAny(['createdBy', 'createdAt', 'inviteCode'])
        && (
             resource.data.createdBy == request.auth.uid
             || (
                  changed().hasOnly(['members'])
                  && request.resource.data.members.toSet()
                       .difference(resource.data.members.toSet())
                       .hasOnly([request.auth.uid])
                  && resource.data.members.toSet()
                       .difference(request.resource.data.members.toSet())
                       .hasOnly([request.auth.uid])
                )
           );

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /slots/{slotId} {
      function groupMembers(gid) {
        return get(/databases/$(database)/documents/groups/$(gid)).data.members;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid in groupMembers(request.resource.data.groupId);

      allow update: if signedIn()
        && !changed().hasAny(['groupId', 'datetime', 'createdAt'])
        && request.auth.uid in groupMembers(resource.data.groupId)
        && (
             !changed().hasAny(['rsvps'])
             || request.resource.data.rsvps.diff(resource.data.rsvps)
                  .affectedKeys().hasOnly([request.auth.uid])
           );

      allow delete: if false;
    }

    match /venues/{venueId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && !changed().hasAny(['ownerId']);

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /schedule/{slotId} {
        allow read: if true;
        allow write: if signedIn()
          && get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId == request.auth.uid;
      }

      match /booked/{bookingId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /reservations/{resId} {
      function party() {
        return resource.data.bookedBy == request.auth.uid
            || resource.data.ownerId == request.auth.uid;
      }

      allow read: if signedIn() && party();

      allow create: if false;

      allow update: if false;

      allow delete: if false;
    }
  }
}
